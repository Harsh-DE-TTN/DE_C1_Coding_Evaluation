{
  "name": "ecommerce-full-etl-pipeline",
  "description": "Data generation → Bronze (per file) → Silver → Gold → Dashboard",
  "max_concurrent_runs": 1,
  "format": "MULTI_TASK",
  "tasks": [
    {
      "task_key": "data_generation",
      "description": "Generate sample CSVs with intentional DQ issues",
      "spark_python_task": {
        "python_file": "REPO_ROOT/src/data_generation/generate_sample_data.py",
        "source": "GIT"
      },
      "job_cluster_key": "etl_cluster"
    },
    {
      "task_key": "bronze_ingest_customers",
      "description": "Ingest customers.csv into bronze.bronze_customers",
      "depends_on": [{"task_key": "data_generation"}],
      "spark_python_task": {
        "python_file": "REPO_ROOT/src/bronze/01_ingest_customers.py",
        "source": "GIT"
      },
      "job_cluster_key": "etl_cluster"
    },
    {
      "task_key": "bronze_ingest_orders",
      "description": "Ingest orders.csv into bronze.bronze_orders",
      "depends_on": [{"task_key": "data_generation"}],
      "spark_python_task": {
        "python_file": "REPO_ROOT/src/bronze/02_ingest_orders.py",
        "source": "GIT"
      },
      "job_cluster_key": "etl_cluster"
    },
    {
      "task_key": "bronze_ingest_products",
      "description": "Ingest products.csv into bronze.bronze_products",
      "depends_on": [{"task_key": "data_generation"}],
      "spark_python_task": {
        "python_file": "REPO_ROOT/src/bronze/03_ingest_products.py",
        "source": "GIT"
      },
      "job_cluster_key": "etl_cluster"
    },
    {
      "task_key": "silver_validate",
      "description": "Validate Bronze data and write Silver PASS/rejected tables",
      "depends_on": [
        {"task_key": "bronze_ingest_customers"},
        {"task_key": "bronze_ingest_orders"},
        {"task_key": "bronze_ingest_products"}
      ],
      "spark_python_task": {
        "python_file": "REPO_ROOT/src/silver/create_silver_tables.py",
        "source": "GIT"
      },
      "job_cluster_key": "etl_cluster"
    },
    {
      "task_key": "gold_aggregate",
      "description": "Build Gold business aggregations from Silver PASS tables",
      "depends_on": [{"task_key": "silver_validate"}],
      "spark_python_task": {
        "python_file": "REPO_ROOT/src/gold/create_gold_tables.py",
        "source": "GIT"
      },
      "job_cluster_key": "etl_cluster"
    },
    {
      "task_key": "dashboard_queries",
      "description": "Execute Gold dashboard SQL queries",
      "depends_on": [{"task_key": "gold_aggregate"}],
      "spark_python_task": {
        "python_file": "REPO_ROOT/src/dashboard/run_dashboard_queries.py",
        "source": "GIT"
      },
      "job_cluster_key": "etl_cluster"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true"
        },
        "spark_env_vars": {
          "BRONZE_INPUT_PATH": "/Volumes/main/default/raw_data",
          "ETL_DATA_OUTPUT_PATH": "/Volumes/main/default/raw_data",
          "DASHBOARD_MATERIALIZE": "true"
        }
      }
    }
  ],
  "git_source": {
    "git_url": "https://github.com/YOUR_ORG/YOUR_REPO.git",
    "git_branch": "feature_1"
  }
}
